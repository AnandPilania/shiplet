# Shiplet — PHP/symfony
APP_PORT=80
APP_ENV=local
TZ=UTC
PHP_VERSION=8.2

# Symfony
APP_SECRET=change-me-in-production

# PostgreSQL
POSTGRES_USER=shiplet
POSTGRES_PASSWORD=secret
POSTGRES_DB=app
POSTGRES_PORT=5432

DATABASE_URL=postgresql://shiplet:secret@postgres:5432/app

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Mailpit (email)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
